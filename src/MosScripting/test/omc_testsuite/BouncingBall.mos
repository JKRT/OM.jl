// name: BouncingBallSimulation
// keywords: simulation, hybrid, event, reinit, instantiateModel, val
// status: correct
//
// The event handler must reinitialize velocity at each ground impact.

loaded := loadFile("BouncingBall.mo");
flatModel := instantiateModel(BouncingBall);
simulation := simulate(BouncingBall, stopTime=2.0,
                       numberOfIntervals=200, tolerance=1e-8);
heightFinal := val(height, 2.0);
velocityFinal := val(velocity, 2.0);
print(loaded, "\n");
print(size(flatModel) > 100, "\n");
print(heightFinal >= 0.0 and heightFinal < 1.0, "\n");
print(velocityFinal > -5.0 and velocityFinal < 5.0, "\n");

// Result:
// true
// true
// true
// true
// endResult
