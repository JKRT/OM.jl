model 'MechanicsExamples.EngineTest'
function 'MechanicsExamples.EngineTest.world.gravityAcceleration'
  input Real[3] 'r';
  input 'Modelica.Mechanics.MultiBody.Types.GravityTypes' 'gravityType' = 'Modelica.Mechanics.MultiBody.Types.GravityTypes'.UniformGravity;
  input Real[3] 'g' = 9.80665 * ('Modelica.Math.Vectors.normalizeWithAssert'({0.0, -1.0, 0.0}));
  input Real 'mu' = 3.986004418e14;
  output Real[3] 'gravity';
algorithm
  'gravity' := if 'gravityType' == 'Modelica.Mechanics.MultiBody.Types.GravityTypes'.UniformGravity then 'g' else if 'gravityType' == 'Modelica.Mechanics.MultiBody.Types.GravityTypes'.PointGravity then {(-'mu' / ('r'[1] * 'r'[1] + 'r'[2] * 'r'[2] + 'r'[3] * 'r'[3]) * ('r'[1] / 'Modelica.Math.Vectors.length'({'r'[1], 'r'[2], 'r'[3]}))), (-'mu' / ('r'[1] * 'r'[1] + 'r'[2] * 'r'[2] + 'r'[3] * 'r'[3]) * ('r'[2] / 'Modelica.Math.Vectors.length'({'r'[1], 'r'[2], 'r'[3]}))), (-'mu' / ('r'[1] * 'r'[1] + 'r'[2] * 'r'[2] + 'r'[3] * 'r'[3]) * ('r'[3] / 'Modelica.Math.Vectors.length'({'r'[1], 'r'[2], 'r'[3]})))} else fill(0.0, 3);

end 'MechanicsExamples.EngineTest.world.gravityAcceleration';

function 'Modelica.Math.Vectors.length'
  input Real[:] 'v';
  output Real 'result';
algorithm
  'result' := sqrt('v' * ('v'));

end 'Modelica.Math.Vectors.length';

function 'Modelica.Math.Vectors.normalize'
  input Real[:] 'v';
  input Real 'eps' = 100.0 * 1.0e-15;
  output Real[size('v', 1)] 'result';
algorithm
  'result' := smooth(0, if 'Modelica.Math.Vectors.length'('v') >= 'eps' then 'v' / ('Modelica.Math.Vectors.length'('v')) else 'v' / ('eps'));

end 'Modelica.Math.Vectors.normalize';

function 'Modelica.Math.Vectors.normalizeWithAssert'
  input Real[:] 'v';
  output Real[size('v', 1)] 'result';
algorithm
  assert('Modelica.Math.Vectors.length'('v') > 0.0, "Vector v={0,0,0} shall be normalized (= v/sqrt(v*v)), but this results in a division by zero.
Provide a non-zero vector!", 'AssertionLevel'.error);
  'result' := 'v' / ('Modelica.Math.Vectors.length'('v'));

end 'Modelica.Math.Vectors.normalizeWithAssert';

function 'Modelica.Mechanics.MultiBody.Frames.Internal.resolve1_der'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  input Real[3] 'v2';
  input Real[3] 'v2_der';
  output Real[3] 'v1_der';
algorithm
  'v1_der' := 'Modelica.Mechanics.MultiBody.Frames.resolve1'('R', {'v2_der'[1] + 'R'.'w'[2] * 'v2'[3] - 'R'.'w'[3] * 'v2'[2], 'v2_der'[2] + 'R'.'w'[3] * 'v2'[1] - 'R'.'w'[1] * 'v2'[3], 'v2_der'[3] + 'R'.'w'[1] * 'v2'[2] - 'R'.'w'[2] * 'v2'[1]});

end 'Modelica.Mechanics.MultiBody.Frames.Internal.resolve1_der';

function 'Modelica.Mechanics.MultiBody.Frames.Internal.resolve2_der'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  input Real[3] 'v1';
  input Real[3] 'v1_der';
  output Real[3] 'v2_der';
algorithm
  'v2_der' := 'Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1_der'[1], 'v1_der'[2], 'v1_der'[3]}) - {'R'.'w'[2] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),3) - 'R'.'w'[3] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),2), 'R'.'w'[3] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),1) - 'R'.'w'[1] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),3), 'R'.'w'[1] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),2) - 'R'.'w'[2] * 'subscriptReal[3]_Integer'('Modelica.Mechanics.MultiBody.Frames.resolve2'('R', {'v1'[1], 'v1'[2], 'v1'[3]}),1)};

end 'Modelica.Mechanics.MultiBody.Frames.Internal.resolve2_der';

function 'Modelica.Mechanics.MultiBody.Frames.Quaternions.from_T'
  input Real[3, 3] 'T';
  input Real[4] 'Q_guess' = 'Modelica.Mechanics.MultiBody.Frames.Quaternions.nullRotation'();
  output Real[4] 'Q';
protected
  Real 'paux';
  Real 'paux4';
  Real 'c1';
  Real 'c2';
  Real 'c3';
  Real 'c4';
  constant Real 'p4limit' = 0.1;
  constant Real 'c4limit' = 4.0 * 'p4limit' * 'p4limit';
algorithm
  'c1' := 1.0 + 'T'[1,1] - 'T'[2,2] - 'T'[3,3];
  'c2' := 1.0 + 'T'[2,2] - 'T'[1,1] - 'T'[3,3];
  'c3' := 1.0 + 'T'[3,3] - 'T'[1,1] - 'T'[2,2];
  'c4' := 1.0 + 'T'[1,1] + 'T'[2,2] + 'T'[3,3];

  if 'c4' > 'c4limit' or ('c4' > 'c1' and 'c4' > 'c2') and 'c4' > 'c3' then
    'paux' := sqrt('c4') / 2.0;
    'paux4' := 4.0 * 'paux';
    'Q' := {('T'[2,3] - 'T'[3,2]) / 'paux4', ('T'[3,1] - 'T'[1,3]) / 'paux4', ('T'[1,2] - 'T'[2,1]) / 'paux4', 'paux'};
  elseif ('c1' > 'c2' and 'c1' > 'c3') and 'c1' > 'c4' then
    'paux' := sqrt('c1') / 2.0;
    'paux4' := 4.0 * 'paux';
    'Q' := {'paux', ('T'[1,2] + 'T'[2,1]) / 'paux4', ('T'[1,3] + 'T'[3,1]) / 'paux4', ('T'[2,3] - 'T'[3,2]) / 'paux4'};
  elseif ('c2' > 'c1' and 'c2' > 'c3') and 'c2' > 'c4' then
    'paux' := sqrt('c2') / 2.0;
    'paux4' := 4.0 * 'paux';
    'Q' := {('T'[1,2] + 'T'[2,1]) / 'paux4', 'paux', ('T'[2,3] + 'T'[3,2]) / 'paux4', ('T'[3,1] - 'T'[1,3]) / 'paux4'};
  elseif true then
    'paux' := sqrt('c3') / 2.0;
    'paux4' := 4.0 * 'paux';
    'Q' := {('T'[1,3] + 'T'[3,1]) / 'paux4', ('T'[2,3] + 'T'[3,2]) / 'paux4', 'paux', ('T'[1,2] - 'T'[2,1]) / 'paux4'};
  end if;

  if 'Q'[1] * 'Q_guess'[1] + 'Q'[2] * 'Q_guess'[2] + 'Q'[3] * 'Q_guess'[3] + 'Q'[4] * 'Q_guess'[4] < 0.0 then
    'Q' := {(-'Q'[1]), (-'Q'[2]), (-'Q'[3]), (-'Q'[4])};
  end if;

end 'Modelica.Mechanics.MultiBody.Frames.Quaternions.from_T';

function 'Modelica.Mechanics.MultiBody.Frames.Quaternions.nullRotation'
  output Real[4] 'Q';
algorithm
  'Q' := {0.0, 0.0, 0.0, 1.0};

end 'Modelica.Mechanics.MultiBody.Frames.Quaternions.nullRotation';

function 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.absoluteRotation'
  input Real[3, 3] 'T1';
  input Real[3, 3] 'T_rel';
  output Real[3, 3] 'T2';
algorithm
  'T2' := {{'T_rel'[1,1] * 'T1'[1,1] + 'T_rel'[1,2] * 'T1'[2,1] + 'T_rel'[1,3] * 'T1'[3,1], 'T_rel'[1,1] * 'T1'[1,2] + 'T_rel'[1,2] * 'T1'[2,2] + 'T_rel'[1,3] * 'T1'[3,2], 'T_rel'[1,1] * 'T1'[1,3] + 'T_rel'[1,2] * 'T1'[2,3] + 'T_rel'[1,3] * 'T1'[3,3]}, {'T_rel'[2,1] * 'T1'[1,1] + 'T_rel'[2,2] * 'T1'[2,1] + 'T_rel'[2,3] * 'T1'[3,1], 'T_rel'[2,1] * 'T1'[1,2] + 'T_rel'[2,2] * 'T1'[2,2] + 'T_rel'[2,3] * 'T1'[3,2], 'T_rel'[2,1] * 'T1'[1,3] + 'T_rel'[2,2] * 'T1'[2,3] + 'T_rel'[2,3] * 'T1'[3,3]}, {'T_rel'[3,1] * 'T1'[1,1] + 'T_rel'[3,2] * 'T1'[2,1] + 'T_rel'[3,3] * 'T1'[3,1], 'T_rel'[3,1] * 'T1'[1,2] + 'T_rel'[3,2] * 'T1'[2,2] + 'T_rel'[3,3] * 'T1'[3,2], 'T_rel'[3,1] * 'T1'[1,3] + 'T_rel'[3,2] * 'T1'[2,3] + 'T_rel'[3,3] * 'T1'[3,3]}};

end 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.absoluteRotation';

function 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.axisRotation'
  input Integer 'axis';
  input Real 'angle';
  output Real[3, 3] 'T';
algorithm
  'T' := if 'axis' == 1 then {{1.0, 0.0, 0.0}, {0, cos('angle'), sin('angle')}, {0, (-sin('angle')), cos('angle')}} else if 'axis' == 2 then {{cos('angle'), 0.0, (-sin('angle'))}, {0.0, 1.0, 0.0}, {sin('angle'), 0.0, cos('angle')}} else {{cos('angle'), sin('angle'), 0}, {(-sin('angle')), cos('angle'), 0}, {0.0, 0.0, 1.0}};

end 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.axisRotation';

function 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.from_nxy'
  input Real[3] 'n_x';
  input Real[3] 'n_y';
  output Real[3, 3] 'T';
protected
  Real[3] 'e_x' = if 'Modelica.Math.Vectors.length'('n_x') < 1.0e-10 then {1.0, 0.0, 0.0} else 'Modelica.Math.Vectors.normalize'('n_x', 100.0 * 1.0e-15);
  Real[3] 'e_y' = if 'Modelica.Math.Vectors.length'('n_y') < 1.0e-10 then {0.0, 1.0, 0.0} else 'Modelica.Math.Vectors.normalize'('n_y', 100.0 * 1.0e-15);
  Real[3] 'n_z_aux' = {'e_x'[2] * 'e_y'[3] - 'e_x'[3] * 'e_y'[2], 'e_x'[3] * 'e_y'[1] - 'e_x'[1] * 'e_y'[3], 'e_x'[1] * 'e_y'[2] - 'e_x'[2] * 'e_y'[1]};
  Real[3] 'n_y_aux' = if 'n_z_aux' * ('n_z_aux') > 1.0e-6 then 'e_y' else if abs('e_x'[1]) > 1.0e-6 then {0.0, 1.0, 0.0} else {1.0, 0.0, 0.0};
  Real[3] 'e_z_aux' = {'e_x'[2] * 'n_y_aux'[3] - 'e_x'[3] * 'n_y_aux'[2], 'e_x'[3] * 'n_y_aux'[1] - 'e_x'[1] * 'n_y_aux'[3], 'e_x'[1] * 'n_y_aux'[2] - 'e_x'[2] * 'n_y_aux'[1]};
  Real[3] 'e_z' = 'Modelica.Math.Vectors.normalize'('e_z_aux', 100.0 * 1.0e-15);
algorithm
  'T' := {'e_x', {'e_z'[2] * 'e_x'[3] - 'e_z'[3] * 'e_x'[2], 'e_z'[3] * 'e_x'[1] - 'e_z'[1] * 'e_x'[3], 'e_z'[1] * 'e_x'[2] - 'e_z'[2] * 'e_x'[1]}, 'e_z'};

end 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.from_nxy';

function 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.resolve1'
  input Real[3, 3] 'T';
  input Real[3] 'v2';
  output Real[3] 'v1';
algorithm
  'v1' := {'T'[1,1] * 'v2'[1] + 'T'[2,1] * 'v2'[2] + 'T'[3,1] * 'v2'[3], 'T'[1,2] * 'v2'[1] + 'T'[2,2] * 'v2'[2] + 'T'[3,2] * 'v2'[3], 'T'[1,3] * 'v2'[1] + 'T'[2,3] * 'v2'[2] + 'T'[3,3] * 'v2'[3]};

end 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.resolve1';

function 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.resolve2'
  input Real[3, 3] 'T';
  input Real[3] 'v1';
  output Real[3] 'v2';
algorithm
  'v2' := {'T'[1,1] * 'v1'[1] + 'T'[1,2] * 'v1'[2] + 'T'[1,3] * 'v1'[3], 'T'[2,1] * 'v1'[1] + 'T'[2,2] * 'v1'[2] + 'T'[2,3] * 'v1'[3], 'T'[3,1] * 'v1'[1] + 'T'[3,2] * 'v1'[2] + 'T'[3,3] * 'v1'[3]};

end 'Modelica.Mechanics.MultiBody.Frames.TransformationMatrices.resolve2';

function 'Modelica.Mechanics.MultiBody.Frames.absoluteRotation'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R1';
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R_rel';
  output 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R2';
algorithm
  'R2' := 'Modelica.Mechanics.MultiBody.Frames.Orientation'('R_rel'.'T' * ('R1'.'T'), 'Modelica.Mechanics.MultiBody.Frames.resolve2'('R_rel', 'R1'.'w') + 'R_rel'.'w');

end 'Modelica.Mechanics.MultiBody.Frames.absoluteRotation';

function 'Modelica.Mechanics.MultiBody.Frames.angularVelocity2'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  output Real[3] 'w';
algorithm
  'w' := 'R'.'w';

end 'Modelica.Mechanics.MultiBody.Frames.angularVelocity2';

function 'Modelica.Mechanics.MultiBody.Frames.axis'
  input Integer 'axis';
  output Real[3] 'e';
algorithm
  'e' := if 'axis' == 1 then {1.0, 0.0, 0.0} else if 'axis' == 2 then {0.0, 1.0, 0.0} else {0.0, 0.0, 1.0};

end 'Modelica.Mechanics.MultiBody.Frames.axis';

function 'Modelica.Mechanics.MultiBody.Frames.nullRotation'
  output 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
algorithm
  'R' := 'Modelica.Mechanics.MultiBody.Frames.Orientation'(identity(3), fill(0.0, 3));

end 'Modelica.Mechanics.MultiBody.Frames.nullRotation';

function 'Modelica.Mechanics.MultiBody.Frames.planarRotation'
  input Real[3] 'e';
  input Real 'angle';
  input Real 'der_angle';
  output 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
algorithm
  'R' := 'Modelica.Mechanics.MultiBody.Frames.Orientation'(promote('e', 2) * (transpose(promote('e', 2))) + (identity(3) - promote('e', 2) * (transpose(promote('e', 2)))) .* (cos('angle')) - {{0.0, (-'e'[3]), 'e'[2]}, {'e'[3], 0.0, (-'e'[1])}, {(-'e'[2]), 'e'[1], 0.0}} .* (sin('angle')), 'e' .* ('der_angle'));

end 'Modelica.Mechanics.MultiBody.Frames.planarRotation';

function 'Modelica.Mechanics.MultiBody.Frames.relativeRotation'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R1';
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R2';
  output 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R_rel';
algorithm
  'R_rel' := 'Modelica.Mechanics.MultiBody.Frames.Orientation'('R2'.'T' * (transpose('R1'.'T')), 'R2'.'w' - 'Modelica.Mechanics.MultiBody.Frames.resolve2'('R2', 'Modelica.Mechanics.MultiBody.Frames.resolve1'('R1', 'R1'.'w')));

end 'Modelica.Mechanics.MultiBody.Frames.relativeRotation';

function 'Modelica.Mechanics.MultiBody.Frames.resolve1'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  input Real[3] 'v2';
  output Real[3] 'v1';
algorithm
  'v1' := {'R'.'T'[1,1] * 'v2'[1] + 'R'.'T'[2,1] * 'v2'[2] + 'R'.'T'[3,1] * 'v2'[3], 'R'.'T'[1,2] * 'v2'[1] + 'R'.'T'[2,2] * 'v2'[2] + 'R'.'T'[3,2] * 'v2'[3], 'R'.'T'[1,3] * 'v2'[1] + 'R'.'T'[2,3] * 'v2'[2] + 'R'.'T'[3,3] * 'v2'[3]};

end 'Modelica.Mechanics.MultiBody.Frames.resolve1';

function 'Modelica.Mechanics.MultiBody.Frames.resolve2'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  input Real[3] 'v1';
  output Real[3] 'v2';
algorithm
  'v2' := {'R'.'T'[1,1] * 'v1'[1] + 'R'.'T'[1,2] * 'v1'[2] + 'R'.'T'[1,3] * 'v1'[3], 'R'.'T'[2,1] * 'v1'[1] + 'R'.'T'[2,2] * 'v1'[2] + 'R'.'T'[2,3] * 'v1'[3], 'R'.'T'[3,1] * 'v1'[1] + 'R'.'T'[3,2] * 'v1'[2] + 'R'.'T'[3,3] * 'v1'[3]};

end 'Modelica.Mechanics.MultiBody.Frames.resolve2';

function 'Modelica.Mechanics.MultiBody.Frames.resolveDyade1'
  input 'Modelica.Mechanics.MultiBody.Frames.Orientation' 'R';
  input Real[3, 3] 'D2';
  output Real[3, 3] 'D1';
