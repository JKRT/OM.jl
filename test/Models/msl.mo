            connect(torque.frame_resolve, revolute.frame_a) annotation(
              Line(points = {{64, 60}, {8, 60}, {8, 20}, {16, 20}}, color = {95, 95, 95}, pattern = LinePattern.Dot, smooth = Smooth.None));
            connect(torque.frame_a, revolute.frame_a) annotation(
              Line(points = {{50, 50}, {8, 50}, {8, 20}, {16, 20}}, color = {95, 95, 95}, thickness = 0.5, smooth = Smooth.None));
            connect(position2.flange, r2.axis) annotation(
              Line(points = {{-32, -20}, {-28, -20}, {-28, -60}}, color = {0, 0, 0}, smooth = Smooth.None));
            connect(position2.support, mounting1D2.flange_b) annotation(
