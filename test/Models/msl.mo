          connect(C5.n, Gnd8.p) annotation(
            Line(points = {{10, -60}, {10, -70}}, color = {0, 0, 255}));
          connect(C3.n, Gnd5.p) annotation(
            Line(points = {{60, -60}, {60, -70}}, color = {0, 0, 255}));
          connect(R3.n, Gnd4.p) annotation(
            Line(points = {{90, -10}, {90, -40}}, color = {0, 0, 255}));
          connect(C2.n, Gnd3.p) annotation(
