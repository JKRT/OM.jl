              Visualizers.FixedShape CrankShape(animation = animation, shapeType = "modelica://Modelica/Resources/Data/Shapes/Engine/crank.dxf", lengthDirection = {1, 0, 0}, extra = 1, widthDirection = {0, 1, 0}, length = crankPinOffset / 0.5, width = crankPinOffset / 0.5, height = crankPinOffset / 0.5, r_shape = {crankLength - crankPinLength / 2 - 0.002, 0, 0}) annotation(
