              connect(cylinder3.crank_a, cylinder2.crank_b) annotation(
                Line(points = {{-30, -10}, {-40, -10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(cylinder3.cylinder_b, cylinder4.cylinder_a) annotation(
                Line(points = {{-10, 10}, {0, 10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(cylinder3.crank_b, cylinder4.crank_a) annotation(
                Line(points = {{-10, -10}, {0, -10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(cylinder4.cylinder_b, cylinder5.cylinder_a) annotation(
                Line(points = {{20, 10}, {30, 10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(cylinder4.crank_b, cylinder5.crank_a) annotation(
                Line(points = {{20, -10}, {30, -10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(cylinder5.cylinder_b, cylinder6.cylinder_a) annotation(
