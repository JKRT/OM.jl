            Placement(transformation(extent = {{66, 0}, {86, 20}}, rotation = 0)));
          D.Converters.LogicToReal Q3(value_0 = 0, value_1 = 1, value_H = 1, value_L = 0, value_m = 0.5, value_U = 0.5, value_W = 0.5, value_X = 0.5, value_Z = 0.5, n = 1) annotation(
