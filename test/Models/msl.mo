              connect(cylinder5.crank_b, cylinder6.crank_a) annotation(
                Line(points = {{50, -10}, {60, -10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(bearing.frame_b, crank.frame_a) annotation(
                Line(points = {{-70, -50}, {-50, -50}}, color = {95, 95, 95}, thickness = 0.5));
              connect(crank.frame_b, cylinder1.crank_a) annotation(
                Line(points = {{-30, -50}, {-24, -50}, {-24, -26}, {-94, -26}, {-94, -10}, {-90, -10}}, color = {95, 95, 95}, thickness = 0.5));
              connect(bearing.axis, flange_b) annotation(
                Line(points = {{-80, -60}, {-80, -66}, {90, -66}, {90, 0}, {110, 0}}, color = {0, 0, 0}));
              connect(frame_a, bearing.frame_a) annotation(
