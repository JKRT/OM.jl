              Placement(transformation(extent = {{-20, 20}, {0, 40}}, rotation = 0)));
            Modelica.Mechanics.Translational.Components.Mass advancedLoad(m = 0.01) "translatory load to be pulled horizontally" annotation(
              Placement(transformation(extent = {{20, 20}, {40, 40}}, rotation = 0)));
            Modelica.Electrical.Analog.Basic.Ground simpleGround annotation(
              Placement(transformation(extent = {{-70, -90}, {-50, -70}}, rotation = 0)));
            Modelica.Electrical.Analog.Sources.StepVoltage simpleSource(V = v_step) annotation(
              Placement(transformation(origin = {-60, -50}, extent = {{-10, -10}, {10, 10}}, rotation = 270)));
            Modelica.Magnetic.FluxTubes.Examples.SolenoidActuator.Components.SimpleSolenoid simpleSolenoid(x(fixed = true)) annotation(
              Placement(transformation(extent = {{-20, -60}, {0, -40}}, rotation = 0)));
            Modelica.Mechanics.Translational.Components.Mass simpleLoad(m = 0.01) "translatory load to be pulled horizontally" annotation(
              Placement(transformation(extent = {{20, -60}, {40, -40}}, rotation = 0)));
