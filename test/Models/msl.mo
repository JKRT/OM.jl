          connect(R2.n, G.p) annotation(
            Line(points = {{100, -30}, {100, -50}, {0, -50}, {0, -70}}, color = {0, 0, 255}));
          connect(C4.n, C5.p) annotation(
            Line(points = {{40, 30}, {60, 30}, {60, -10}}, color = {0, 0, 255}));
          connect(C4.n, R2.p) annotation(
            Line(points = {{40, 30}, {100, 30}, {100, -10}}, color = {0, 0, 255}));
          connect(C3.n, G.p) annotation(
            Line(points = {{0, -30}, {0, -30}, {0, -70}}, color = {0, 0, 255}));
          connect(C5.n, G.p) annotation(
            Line(points = {{60, -30}, {60, -50}, {0, -50}, {0, -70}}, color = {0, 0, 255}));
          connect(C1.n, C3.n) annotation(
            Line(points = {{-60, -30}, {-60, -50}, {0, -50}, {0, -30}}, color = {0, 0, 255}));
          connect(C1.n, C5.n) annotation(
