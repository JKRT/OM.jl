          connect(zeroPosition.frame_resolve, cutTorque.frame_resolve) annotation(
            Line(points = {{-20, -30}, {-44, -30}, {-44, -10}}, color = {95, 95, 95}, pattern = LinePattern.Dot, smooth = Smooth.None));
          annotation(
            Icon(coordinateSystem(preserveAspectRatio = true, extent = {{-100, -100}, {100, 100}}), graphics = {Text(extent = {{-180, -72}, {-64, -98}}, lineColor = {0, 0, 0}, textString = "torque"), Line(points = {{-80, -100}, {-80, 0}}, color = {0, 0, 127})}),
            Documentation(info = "<HTML>
<p>
The cut-torque acting between the two frames to which this
model is connected, is determined and provided at the output signal connector
<b>torque</b> (= frame_a.t). If parameter <b>positiveSign</b> =
