            Placement(transformation(origin = {-42, 24}, extent = {{-10, -10}, {10, 10}}, rotation = 270)));
          Sources.V_pulse vin2(V2 = 5, TR = 0.001, TF = 0.001, PW = 2, PER = 10, TD = 1) annotation(
            Placement(transformation(origin = {-44, -44}, extent = {{-10, -10}, {10, 10}}, rotation = 270)));
          Sources.V_pulse v(TD = 0.5, TR = 0.1, V2 = 5) annotation(
            Placement(transformation(extent = {{-10, -10}, {10, 10}}, rotation = 270, origin = {62, 34})));
        equation
          connect(mn1.B, mn1.S) annotation(
            Line(points = {{4, -34}, {4, -44}, {-6, -44}}, color = {0, 0, 255}));
          connect(mn2.B, mn2.S) annotation(
