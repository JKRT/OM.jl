            Modelica.Electrical.Machines.Sensors.MechanicalPowerSensor mechanicalPowerSensor3 annotation(
              Placement(transformation(extent = {{50, -90}, {70, -70}}, rotation = 0)));
            Modelica.Mechanics.Rotational.Sources.ConstantSpeed constantSpeedM(final w_fixed = w, useSupport = false) annotation(
