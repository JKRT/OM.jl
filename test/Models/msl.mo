            inner Parts.Fixed fixed annotation(
              Placement(transformation(extent = {{-62, -90}, {-42, -70}}, rotation = 0)));
            Parts.Rotor1D rotor1D(J = 2, phi(fixed = true), w(fixed = true)) annotation(
