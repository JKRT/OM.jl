          connect(variableResistor.n, plug_n.pin) annotation(
            Line(points = {{10, 0}, {100, 0}}, color = {0, 0, 255}));
          connect(R, variableResistor.R) annotation(
            Line(points = {{0, 100}, {0, 11}}, color = {0, 0, 255}));
