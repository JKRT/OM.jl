              Dialog(tab = "Nominal resistances and inductances", groupImage = "modelica://Modelica/Resources/Images/Electrical/Machines/SMR.png"));
            parameter Modelica.SIunits.Inductance Lmq(start = 0.9 / (2 * pi * fsNominal)) "Stator main field inductance per phase, q-axis" annotation(
