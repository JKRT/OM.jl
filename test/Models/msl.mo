            Rotational.Components.Inertia inertia1(J = cyl1.I[1, 1], a(fixed = false), phi(fixed = true, start = 0), w(fixed = true, start = 0)) annotation(
              Placement(transformation(extent = {{-20, -40}, {0, -20}}, rotation = 0)));
