                Placement(transformation(origin = {30, 0}, extent = {{-10, 10}, {10, -10}}, rotation = 90)));
              Modelica.Electrical.MultiPhase.Basic.Delta Rot22(final m = m) annotation(
                Placement(transformation(origin = {40, 20}, extent = {{-10, 10}, {10, -10}}, rotation = 180)));
              Modelica.Electrical.MultiPhase.Basic.Delta Delta1(final m = m) annotation(
                Placement(transformation(extent = {{-50, -30}, {-30, -10}}, rotation = 0)));
