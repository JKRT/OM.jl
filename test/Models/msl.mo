              parameter SI.Length cylinderLength = cylinderTopPosition - (pistonLength + rodLength - crankPinOffset) "Maximum length of cylinder volume";
              Modelica.Mechanics.MultiBody.Parts.BodyCylinder Piston(diameter = 0.1, r = {0, pistonLength, 0}, color = {180, 180, 180}, animation = animation) annotation(
