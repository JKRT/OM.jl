            Placement(transformation(extent = {{50, -60}, {70, -40}})));
          Modelica.Blocks.Continuous.Der der_r_rel[3] annotation(
            Placement(transformation(extent = {{-20, -20}, {0, 0}}, rotation = -90, origin = {10, -40})));
          Modelica.Mechanics.MultiBody.Sensors.TransformRelativeVector tansformRelativeVector(frame_r_in = Modelica.Mechanics.MultiBody.Types.ResolveInFrameAB.frame_a, frame_r_out = resolveInFrame) annotation(
            Placement(transformation(extent = {{-10, -80}, {10, -60}})));
