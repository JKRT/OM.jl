          annotation(
            Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Line(points = {{-90, 0}, {-70, 0}}, color = {0, 0, 255}), Rectangle(extent = {{-70, 30}, {70, -30}}, lineColor = {0, 0, 255}, fillColor = {255, 255, 255}, fillPattern = FillPattern.Solid), Line(points = {{70, 0}, {90, 0}}, color = {0, 0, 255}), Line(points = {{0, 90}, {0, 30}}, color = {0, 0, 255}), Text(extent = {{-150, -100}, {150, -40}}, textString = "%name", lineColor = {0, 0, 255}), Text(extent = {{-100, 40}, {100, 80}}, lineColor = {0, 0, 0}, textString = "m=%m")}),
            Documentation(info = "<HTML>
<p>
Contains m variable resistors (Modelica.Electrical.Analog.Basic.VariableResistor)
