              Placement(transformation(origin = {0, 50}, extent = {{-10, 10}, {10, -10}}, rotation = 270)));
            Machines.BasicMachines.Transformers.Yy.Yy00 transformer(n = transformerData.n, R1 = transformerData.R1, L1sigma = transformerData.L1sigma, R2 = transformerData.R2, L2sigma = transformerData.L2sigma, T1Ref = 293.15, alpha20_1(displayUnit = "1/K") = Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero, T2Ref = 293.15, alpha20_2(displayUnit = "1/K") = Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero, T1Operational = 293.15, T2Operational = 293.15) annotation(
