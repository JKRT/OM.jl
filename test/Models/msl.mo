          Modelica.Electrical.Analog.Sources.SineVoltage SineVoltage1(V = 220, freqHz = 1) annotation(
            Placement(transformation(origin = {-70, 40}, extent = {{-10, -10}, {10, 10}}, rotation = 270)));
          Modelica.Thermal.HeatTransfer.Components.ThermalConductor thermalConductor(G = 50) annotation(
            Placement(transformation(origin = {4, 34}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
          Thermal.HeatTransfer.Celsius.FixedTemperature fixedTemperature(T = 20) annotation(
            Placement(transformation(extent = {{52, 24}, {32, 44}})));
        equation
          connect(SineVoltage1.n, G.p) annotation(
