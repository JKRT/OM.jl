                Placement(transformation(extent = {{60, -10}, {80, 10}}, rotation = 0)));
              Joints.Revolute bearing(useAxisFlange = true, n = {1, 0, 0}, cylinderLength = 0.02, cylinderDiameter = 0.06, animation = true) annotation(
                Placement(transformation(extent = {{-90, -40}, {-70, -60}}, rotation = 0)));
              Parts.BodyShape crank(animation = false, r = {0, 0, 0}, r_CM = {6 * 0.1 / 2, 0, 0}, I_22 = 1.e-5, I_33 = 1.e-5, m = 6 * 30, I_11 = 0.1) annotation(
                Placement(transformation(extent = {{-50, -60}, {-30, -40}}, rotation = 0)));
              Modelica.Mechanics.Rotational.Interfaces.Flange_b flange_b annotation(
                Placement(transformation(extent = {{100, -10}, {120, 10}}, rotation = 0)));
              Interfaces.Frame_a frame_a annotation(
                Placement(transformation(origin = {0, -101}, extent = {{-16, -16}, {16, 16}}, rotation = 270)));
            equation
